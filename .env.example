# Application URL
NEXT_PUBLIC_APP_URL="https://remique.vercel.app"

# Neon PostgreSQL Database
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@host/db?sslmode=require"

# OpenAI API Key
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_API_KEY="sk-proj-..."

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN="EA..."
WHATSAPP_PHONE_NUMBER_ID="120..."
WHATSAPP_VERIFY_TOKEN="your_verify_token"
WHATSAPP_APP_SECRET="your_app_secret"

# Upstash QStash
QSTASH_URL="https://qstash-us-east-1.upstash.io"
QSTASH_TOKEN="ey..."
QSTASH_CURRENT_SIGNING_KEY="sig_..."
QSTASH_NEXT_SIGNING_KEY="sig_..."

HEALTH_CHECK_SECRET="your_health_check_secret"

# AWS (SQS worker Lambda only — the Next.js app never touches S3)
SQS_QUEUE_URL="https://sqs.ap-southeast-1.amazonaws.com/<acct>/remique-inbound.fifo"
S3_BUCKET_DOCUMENTS="remique-documents"
AWS_S3_REGION="ap-southeast-1"
