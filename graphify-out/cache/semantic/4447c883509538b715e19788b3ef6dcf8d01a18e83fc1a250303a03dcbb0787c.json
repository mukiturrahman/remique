{"nodes": [{"id": "neon_ai_gateway_skill", "label": "neon-ai-gateway Skill", "file_type": "document", "source_file": ".agents/skills/neon-ai-gateway/SKILL.md", "source_location": null, "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon-ai-gateway", "captured_at": null, "author": null, "contributor": null}, {"id": "neon_ai_gateway_skill_ai_gateway", "label": "Neon AI Gateway", "file_type": "concept", "source_file": ".agents/skills/neon-ai-gateway/SKILL.md", "source_location": "# Neon AI Gateway", "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon-ai-gateway", "captured_at": null, "author": null, "contributor": null, "rationale": "An LLM inference layer built into the branch and powered by Databricks, so AI requests branch with the project and sit next to the data instead of requiring separate provider infrastructure."}, {"id": "neon_ai_gateway_skill_one_credential", "label": "One Credential, Model Portability", "file_type": "rationale", "source_file": ".agents/skills/neon-ai-gateway/SKILL.md", "source_location": "## When to Use", "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon-ai-gateway", "captured_at": null, "author": null, "contributor": null, "rationale": "A single Neon credential reaches the whole catalog and the endpoint is OpenAI-compatible, so switching between Claude, GPT and Gemini is a one-field change rather than a rewiring; a deep single-provider integration with no branching need is the case where a direct provider SDK still wins."}, {"id": "neon_ai_gateway_skill_dialect_routes", "label": "Gateway Dialect Routes (/v1, /openai/v1, /anthropic, /gemini)", "file_type": "concept", "source_file": ".agents/skills/neon-ai-gateway/SKILL.md", "source_location": "## Environment Variables", "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon-ai-gateway", "captured_at": null, "author": null, "contributor": null, "rationale": "The base URL is a bare host so each SDK appends its own dialect path; native Anthropic and Gemini routes exist to preserve provider-specific features (extended thinking, prompt caching, generateContent) that the unified OpenAI-compatible route cannot express."}, {"id": "neon_ai_gateway_skill_gateway_env_vars", "label": "NEON_AI_GATEWAY_TOKEN / _BASE_URL", "file_type": "concept", "source_file": ".agents/skills/neon-ai-gateway/SKILL.md", "source_location": "## Environment Variables", "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon-ai-gateway", "captured_at": null, "author": null, "contributor": null, "rationale": "Neon injects only the Neon-branded vars and never OPENAI_*, so a bare openai() client will not pick the gateway up from the environment on its own."}, {"id": "neon_ai_gateway_skill_ai_sdk_provider", "label": "@neon/ai-sdk-provider", "file_type": "concept", "source_file": ".agents/skills/neon-ai-gateway/SKILL.md", "source_location": "## Build Agents with the Vercel AI SDK (Recommended)", "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon-ai-gateway", "captured_at": null, "author": null, "contributor": null, "rationale": "Reads the injected gateway credentials with zero config and routes each model to its best endpoint (Anthropic to Messages, OpenAI/Codex to Responses, everything else to MLflow), which is why it is preferred over the bare @ai-sdk/openai provider."}, {"id": "neon_ai_gateway_skill_mastra_agent", "label": "Mastra neon/<model> Magic String", "file_type": "concept", "source_file": ".agents/skills/neon-ai-gateway/SKILL.md", "source_location": "## Build Agents with Mastra (Recommended)", "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon-ai-gateway", "captured_at": null, "author": null, "contributor": null}, {"id": "neon_ai_gateway_skill_models_endpoint", "label": "/v1/models Live Catalog Endpoint", "file_type": "concept", "source_file": ".agents/skills/neon-ai-gateway/SKILL.md", "source_location": "## List Available Models at Runtime (`/v1/models`)", "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon-ai-gateway", "captured_at": null, "author": null, "contributor": null, "rationale": "The catalog shifts over time and is branch-scoped, so the live endpoint (served only on the unified /v1 dialect) is the source of truth rather than a hard-coded provider list; pricing and context_length are null there, so models.dev covers capabilities."}, {"id": "neon_ai_gateway_skill_plan_gating", "label": "Plan and Model-Catalog Gating", "file_type": "rationale", "source_file": ".agents/skills/neon-ai-gateway/SKILL.md", "source_location": "### Enabling the gateway: plan and model-catalog gating", "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon-ai-gateway", "captured_at": null, "author": null, "contributor": null, "rationale": "Two distinct failure modes must be told apart when debugging: a Free plan blocks provisioning entirely, while a paid plan with a trimmed beta catalog only needs a model-access request from the Console."}], "edges": [{"source": "neon_ai_gateway_skill", "target": "neon_skill", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/neon-ai-gateway/SKILL.md", "source_location": "metadata.parent: neon", "weight": 1.0}, {"source": "neon_ai_gateway_skill", "target": "neon_ai_gateway_skill_ai_gateway", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/neon-ai-gateway/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "neon_ai_gateway_skill", "target": "neon_ai_gateway_skill_dialect_routes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/neon-ai-gateway/SKILL.md", "source_location": "## Environment Variables", "weight": 1.0}, {"source": "neon_ai_gateway_skill", "target": "neon_ai_gateway_skill