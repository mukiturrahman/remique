{"nodes": [{"id": "neon_skill", "label": "neon Skill (Overview)", "file_type": "document", "source_file": ".agents/skills/neon/SKILL.md", "source_location": null, "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon", "captured_at": null, "author": null, "contributor": null}, {"id": "neon_skill_backend_primitives", "label": "Neon Backend Primitives", "file_type": "concept", "source_file": ".agents/skills/neon/SKILL.md", "source_location": "## Backend Primitives", "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon", "captured_at": null, "author": null, "contributor": null}, {"id": "neon_skill_backend_primitives_not_hosting", "label": "Backend Primitives, Not App Hosting", "file_type": "rationale", "source_file": ".agents/skills/neon/SKILL.md", "source_location": "## Architecture: How to Use Neon", "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon", "captured_at": null, "author": null, "contributor": null, "rationale": "Neon deliberately does not host frontends; it supplies composable backend primitives so the app platform (Vercel/Netlify) keeps owning UI and routing, and only workloads that outgrow short serverless limits move onto Neon Functions."}, {"id": "neon_skill_neon_ts", "label": "neon.ts Infrastructure as Code", "file_type": "concept", "source_file": ".agents/skills/neon/SKILL.md", "source_location": "## Neon Infrastructure as Code", "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon", "captured_at": null, "author": null, "contributor": null, "rationale": "One TypeScript file declares every branch service in version control so provisioning is reconciled Terraform-style (config status / plan / apply) instead of drifting through imperative CLI steps."}, {"id": "neon_skill_branch_first_dev_flow", "label": "Branch-First Dev Flow", "file_type": "concept", "source_file": ".agents/skills/neon/SKILL.md", "source_location": "## Branch-First Dev Flow", "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon", "captured_at": null, "author": null, "contributor": null}, {"id": "neon_skill_copy_on_write_branch", "label": "Copy-on-Write Branch", "file_type": "concept", "source_file": ".agents/skills/neon/SKILL.md", "source_location": null, "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon", "captured_at": null, "author": null, "contributor": null, "rationale": "A branch shares data with its parent until writes diverge, stored as deltas \u2014 which is what makes preview/CI/agent environments instant and free of data duplication."}, {"id": "neon_skill_neon_cli", "label": "Neon CLI", "file_type": "concept", "source_file": ".agents/skills/neon/SKILL.md", "source_location": "### Getting Started with the Neon CLI", "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon", "captured_at": null, "author": null, "contributor": null, "rationale": "Preferred over the MCP server because it exposes more capabilities, including deploying Neon Functions."}, {"id": "neon_skill_neon_mcp_server", "label": "Neon MCP Server", "file_type": "concept", "source_file": ".agents/skills/neon/SKILL.md", "source_location": "### Getting Started with the Neon MCP Server", "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon", "captured_at": null, "author": null, "contributor": null}, {"id": "neon_skill_parse_env", "label": "parseEnv (@neon/env)", "file_type": "concept", "source_file": ".agents/skills/neon/SKILL.md", "source_location": "### Type-safe env vars with parseEnv", "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon", "captured_at": null, "author": null, "contributor": null, "rationale": "Derives typed, validated env namespaces from the same neon.ts config object so injected credentials are not read as untyped process.env strings."}, {"id": "neon_skill_us_east_2_beta_gating", "label": "us-east-2 Public Beta Gating", "file_type": "rationale", "source_file": ".agents/skills/neon/SKILL.md", "source_location": "### Public Beta Service Availability", "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon", "captured_at": null, "author": null, "contributor": null, "rationale": "Object Storage, Functions, and the AI Gateway are beta and only serve projects in us-east-2, so region must be confirmed before any setup work begins."}, {"id": "neon_skill_observability_branch_logs", "label": "Branch Logs and Observability", "file_type": "concept", "source_file": ".agents/skills/neon/SKILL.md", "source_location": "## Observability", "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon", "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "neon_skill", "target": "neon_skill_backend_primitives", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/neon/SKILL.md", "source_location": "## Backend Primitives", "weight": 1.0}, {"source": "neon_skill", "target": "neon_skill_neon_ts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/neon/SKILL.md", "source_location": "## Neon Infrastructure as Code", "weight": 1.0}, {"source": "neon_skill", "target": "neon_skill_branch_first_dev_flow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/neon/SKILL.md", "source_location": "## Branch-First Dev Flow", "weight": 1.0}, {"source": "neon_skill", "target": "neon_skill_copy_on_write_branch", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/neon/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "neon_skill", "target": "neon_skill_neon_cli", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/neon/SKILL.md", 