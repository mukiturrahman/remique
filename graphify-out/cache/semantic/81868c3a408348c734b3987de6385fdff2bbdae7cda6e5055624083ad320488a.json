{"nodes": [{"id": "neon_postgres_skill", "label": "neon-postgres Skill", "file_type": "document", "source_file": ".agents/skills/neon-postgres/SKILL.md", "source_location": null, "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon-postgres", "captured_at": null, "author": null, "contributor": null}, {"id": "neon_postgres_skill_lakebase_postgres", "label": "Lakebase Postgres", "file_type": "concept", "source_file": ".agents/skills/neon-postgres/SKILL.md", "source_location": "# Lakebase Postgres", "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon-postgres", "captured_at": null, "author": null, "contributor": null, "rationale": "OLTP built directly on cloud object storage with storage decoupled from compute, which is what enables autoscaling, branching, instant restore and scale-to-zero; it is the same database reached through Neon or Databricks."}, {"id": "neon_postgres_skill_pooled_vs_direct", "label": "Pooled vs Direct Connections", "file_type": "rationale", "source_file": ".agents/skills/neon-postgres/SKILL.md", "source_location": "#### When to use pooled vs direct connections", "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon-postgres", "captured_at": null, "author": null, "contributor": null, "rationale": "Pooled (-pooler) for web and serverless request traffic; direct for migrations, dumps, logical replication, LISTEN/NOTIFY and anything needing real session state."}, {"id": "neon_postgres_skill_drizzle_orm", "label": "Drizzle + Driver Selection", "file_type": "concept", "source_file": ".agents/skills/neon-postgres/SKILL.md", "source_location": "### 3. Pick the connection method and driver", "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon-postgres", "captured_at": null, "author": null, "contributor": null, "rationale": "node-postgres is recommended where the runtime is long-lived (Vercel Fluid, Cloudflare Hyperdrive, Neon Functions) because the pool is reused; the @neondatabase/serverless driver is for genuinely isolated serverless/edge runtimes."}, {"id": "neon_postgres_skill_scale_to_zero", "label": "Scale to Zero", "file_type": "concept", "source_file": ".agents/skills/neon-postgres/SKILL.md", "source_location": "## Scale to Zero", "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon-postgres", "captured_at": null, "author": null, "contributor": null, "rationale": "Idle computes suspend after ~5 minutes to cut idle cost, trading a few hundred ms of cold start on the first query; suspension can only be disabled on paid plans."}, {"id": "neon_postgres_skill_autoscaling", "label": "Autoscaling", "file_type": "concept", "source_file": ".agents/skills/neon-postgres/SKILL.md", "source_location": "## Autoscaling", "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon-postgres", "captured_at": null, "author": null, "contributor": null}, {"id": "neon_postgres_skill_instant_restore", "label": "Instant Restore", "file_type": "concept", "source_file": ".agents/skills/neon-postgres/SKILL.md", "source_location": "## Instant Restore", "source_url": "https://github.com/neondatabase/agent-skills/tree/main/skills/neon-postgres", "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "neon_postgres_skill", "target": "neon_skill", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/neon-postgres/SKILL.md", "source_location": "metadata.parent: neon", "weight": 1.0}, {"source": "neon_postgres_skill", "target": "neon_postgres_skill_lakebase_postgres", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/neon-postgres/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "neon_postgres_skill", "target": "neon_postgres_skill_pooled_vs_direct", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "