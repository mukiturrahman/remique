{"nodes": [{"id": "product", "label": "PRODUCT.md (Remique Product Brief)", "file_type": "document", "source_file": "PRODUCT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "product_remique", "label": "Remique (WhatsApp Reminder Assistant)", "file_type": "concept", "source_file": "PRODUCT.md", "source_location": "## Product Purpose", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turns a plain WhatsApp message into a scheduled reminder that fires back on WhatsApp, so success is measured as one natural sentence in, a confirmation in seconds, and on-time delivery without leaving the app."}, {"id": "product_zero_friction", "label": "Zero Friction Is the Product", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": "## Product Principles", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anything implying install, signup, or configuration is a lie about Remique \u2014 the entry point is a WhatsApp thread with no web app, dashboard, or login."}, {"id": "product_language_wedge", "label": "The Language Wedge", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": "## Positioning", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The defensible mechanism is Bangla/Banglish/Bengali-script temporal parsing that replies in the user's own language and script; showing Banglish understood correctly beats any adjective about AI."}, {"id": "product_bangla_time_model", "label": "Bangladeshi Time Vocabulary Model", "file_type": "concept", "source_file": "PRODUCT.md", "source_location": "## Positioning", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicit idiom mapping \u2014 kalke, porshu, shokal 09:00, dupur 14:00, bikal 17:00, shondha 19:30, raat 21:00, X ghonta por \u2014 mirrored from src/lib/gemini.ts, with Asia/Dhaka (UTC+6) as the default timezone."}, {"id": "product_stack", "label": "Remique Implementation Stack", "file_type": "concept", "source_file": "PRODUCT.md", "source_location": "## Capabilities and Constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gemini (@google/genai) parses, Upstash QStash schedules delivery, Postgres via Prisma stores, Meta HMAC verifies inbound webhooks; Next.js 15 App Router with React 19 and Tailwind 3 renders a single server-component landing page."}, {"id": "product_no_fabricated_claims", "label": "No Fabricated Commercial Claims", "file_type": "rationale", "source_file": "PRODUCT.md", "source_location": "## Evidence on Hand", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User counts, testimonials, uptime/SLA numbers, press, funding, delivery rates and partner logos are absent and must not be invented; the page has behavior to show, not numbers to quote."}], "edges": [{"source": "product", "target": "product_remique", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": "## Product Purpose", "weight": 1.0}, {"source": "product", "target": "product_bangla_time_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": "## Positioning", "weight": 1.0}, {"source": "product", "target": "product_stack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": "## Capabilities and Constraints", "weight": 1.0}, {"source": "product_zero_friction", "target": "product_remique", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PRODUCT.md", "source_location": "## Product Principles", "weight": 1.0}, {"source": "product_language_wedge", "target": "product_remique", "relati